# ========================================================
# KIRTI STORE CLIENT - ENVIRONMENT CONFIGURATION
# ========================================================

# In web browser development (npm run dev), leave blank to use the Vite proxy (/api -> localhost:5000).
# When testing on Android Emulator:
# VITE_API_URL=http://10.0.2.2:5000

# When testing on a physical Android or iOS device over Wi-Fi:
# Replace 192.168.1.100 with your computer's local Wi-Fi IP address (run 'ipconfig' in terminal)
# VITE_API_URL=http://192.168.1.100:5000

# In Production (deployed cloud API):
# VITE_API_URL=https://api.yourkirtistore.com

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase Authentication (for Real-time Phone OTP verification)
# From Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kirti-store
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
