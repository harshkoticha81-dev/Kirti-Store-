# ========================================================
# KIRTI STORE - ENVIRONMENT CONFIGURATION
# ========================================================

# SERVER ENVIRONMENT
NODE_ENV=development
PORT=5000

# DATABASE (Local MongoDB or MongoDB Atlas URI)
# Local default:
MONGODB_URI=mongodb://127.0.0.1:27017/kirti-store
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kirti-store?retryWrites=true&w=majority

# JWT AUTHENTICATION
JWT_SECRET=kirti_store_super_secure_jwt_secret_key_2026_modern_appliances
JWT_EXPIRES_IN=7d

# CLIENT ORIGIN (CORS)
CLIENT_URL=http://localhost:5173

# INITIAL ADMIN SETUP (Used by seed script / manual provisioning)
ADMIN_NAME=Kirti Admin
ADMIN_EMAIL=admin@kirtistore.com
ADMIN_PASSWORD=Admin@KirtiStore2026
ADMIN_PHONE=+919876543210

# OPTIONAL: PAYMENT GATEWAY (Razorpay / Mock payment integration)
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret_for_local_testing

# OPTIONAL: CLOUDINARY (If using Cloudinary for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FIREBASE CLOUD MESSAGING (FCM - Native Mobile Push Notifications)
# Option 1: File path to Firebase serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebaseServiceAccount.json
# Option 2: Direct service account JSON string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Option 3: Individual credentials
# FIREBASE_PROJECT_ID=kirti-store-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@kirti-store-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

